<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <linearGradient id="helixGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0284c7"/>
      <stop offset="50%" stop-color="#38bdf8"/>
      <stop offset="100%" stop-color="#4f46e5"/>
    </linearGradient>
    <linearGradient id="shieldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a"/>
      <stop offset="100%" stop-color="#1e293b"/>
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="2" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Outer Cyber Hex Shield -->
  <rect x="4" y="4" width="56" height="56" rx="16" fill="url(#shieldGrad)" stroke="url(#helixGrad)" stroke-width="2.5" />
  
  <!-- Subtle Internal Grid Gridlines -->
  <line x1="16" y1="4" x2="16" y2="60" stroke="rgba(56, 189, 248, 0.1)" stroke-width="1"/>
  <line x1="48" y1="4" x2="48" y2="60" stroke="rgba(56, 189, 248, 0.1)" stroke-width="1"/>
  <line x1="4" y1="32" x2="60" y2="32" stroke="rgba(56, 189, 248, 0.1)" stroke-width="1"/>

  <!-- Cyber Double Helix Nodes -->
  <!-- Strand 1 -->
  <path d="M20 18 Q32 26 44 18 Q32 32 20 46 Q32 38 44 46" fill="none" stroke="url(#helixGrad)" stroke-width="3" stroke-linecap="round" filter="url(#glow)"/>
  
  <!-- Strand 2 (Intertwined) -->
  <path d="M44 18 Q32 26 20 18 Q32 32 44 46 Q32 38 20 46" fill="none" stroke="#38bdf8" stroke-width="2.2" stroke-linecap="round" stroke-dasharray="1 3"/>

  <!-- Cross Basepairs / Rungs -->
  <line x1="26" y1="21" x2="38" y2="21" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" opacity="0.8"/>
  <line x1="22" y1="32" x2="42" y2="32" stroke="#4f46e5" stroke-width="2.5" stroke-linecap="round" opacity="0.9"/>
  <line x1="26" y1="43" x2="38" y2="43" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" opacity="0.8"/>

  <!-- Central Quantum Energy Core -->
  <circle cx="32" cy="32" r="5" fill="#38bdf8" filter="url(#glow)"/>
  <circle cx="32" cy="32" r="2.5" fill="#ffffff"/>

  <!-- Active Status Blip -->
  <circle cx="48" cy="16" r="3" fill="#10b981" filter="url(#glow)"/>
</svg>